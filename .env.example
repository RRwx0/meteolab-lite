# Скопируйте в .env или задайте переменные окружения перед запуском.
# Секретов здесь нет: сервер слушает только loopback и не требует авторизации.

# Адрес и порт Python-сервера WtS (по умолчанию 127.0.0.1:8770)
WTS_HOST=127.0.0.1
WTS_PORT=8770

# Каталог результатов. По умолчанию ~/.meteolab/wts
# WTS_DATA_DIR=C:\Users\Пользователь\.meteolab\wts

# Сколько часов хранить результаты задач (0 — не удалять)
WTS_TTL_HOURS=24

# Сколько задач разрешено одновременно
WTS_MAX_JOBS=8
